<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sapam.inventario.javafx.controller.HerramientaFormController">
    <VBox alignment="TOP_CENTER" spacing="10" style="-fx-background-color: white;">
        <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
        </padding>

        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Nueva herramienta" />

        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="160" />
                <ColumnConstraints minWidth="300" />
            </columnConstraints>

            <Label GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;" text="Nombre *" />
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Taladro percutor" />

            <Label GridPane.columnIndex="0" GridPane.rowIndex="1" text="Marca" />
            <TextField fx:id="txtMarca" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Bosch" />

            <Label GridPane.columnIndex="0" GridPane.rowIndex="2" text="Modelo" />
            <TextField fx:id="txtModelo" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="GSB 13 RE" />

            <Label GridPane.columnIndex="0" GridPane.rowIndex="3" text="Número de serie" />
            <TextField fx:id="txtSerie" GridPane.columnIndex="1" GridPane.rowIndex="3" promptText="Si aplica" />

            <Label GridPane.columnIndex="0" GridPane.rowIndex="4" text="Estado físico" />
            <ComboBox fx:id="cbEstado" GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="300" promptText="NUEVO" />

            <Label GridPane.columnIndex="0" GridPane.rowIndex="5" text="Área responsable" />
            <TextField fx:id="txtArea" GridPane.columnIndex="1" GridPane.rowIndex="5" promptText="Almacén" />

            <Label GridPane.columnIndex="0" GridPane.rowIndex="6" text="Observaciones" />
            <TextArea fx:id="taObservaciones" GridPane.columnIndex="1" GridPane.rowIndex="6" prefRowCount="3" promptText="Accesorios, estado, etc." />
        </GridPane>

        <Label fx:id="lblError" alignment="CENTER" style="-fx-text-fill: #dc3545;" text="" />

        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Etiqueta" />
        <HBox alignment="CENTER" spacing="20">
            <ImageView fx:id="imgCodigo" fitHeight="150" fitWidth="150" preserveRatio="true" />
            <VBox spacing="8">
                <Label fx:id="lblCodigoBarras" style="-fx-font-family: Consolas; -fx-font-size: 13px; -fx-text-fill: #2C3E50;" text="(se genera al guardar)" />
                <Label style="-fx-text-fill: #6c757d;" text="El código lo asigna el sistema: es el de la etiqueta impresa y el que escribe el lector en la caja de búsqueda." wrapText="true" />
                <Button fx:id="btnImprimirCodigo" disable="true" onAction="#imprimirEtiqueta" style="-fx-background-color: #28A745; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40px; -fx-background-radius: 8; -fx-cursor: hand;" text="Imprimir etiqueta" />
            </VBox>
        </HBox>

        <HBox alignment="CENTER" spacing="10">
            <Button onAction="#guardar" style="-fx-background-color: #28A745; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-pref-width: 120px;" text="Guardar" />
            <Button onAction="#cancelar" style="-fx-background-color: #E3F2FD; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 8; -fx-pref-width: 120px;" text="Cancelar" />
        </HBox>
    </VBox>
</ScrollPane>
