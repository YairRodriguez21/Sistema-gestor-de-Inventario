<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sapam.inventario.javafx.controller.UsuariosController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Usuarios del sistema" />
    <Label fx:id="lblResumen" style="-fx-text-fill: #6c757d;" text="Alta, edición y baja de cuentas" />

    <HBox alignment="CENTER_LEFT" spacing="8">
        <TextField fx:id="txtBuscar" onAction="#buscar" promptText="Buscar por nombre o correo" style="-fx-pref-height: 32px; -fx-background-radius: 8;" />
        <Button onAction="#buscar" style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Buscar" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnNueva" onAction="#nueva" style="-fx-background-color: #17A2B8; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="+ Nueva cuenta" />
        <Button fx:id="btnEditar" onAction="#editar" style="-fx-background-color: #6C757D; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Editar" />
        <Button fx:id="btnBaja" onAction="#baja" style="-fx-background-color: #DC3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Dar de baja" />
        <Button fx:id="btnReactivar" onAction="#reactivar" style="-fx-background-color: #28A745; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Reactivar" />
        <Button onAction="#actualizar" style="-fx-background-color: #E3F2FD; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 8;" text="Actualizar" />
        <Button onAction="#cerrar" style="-fx-background-color: #E3F2FD; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 8;" text="Cerrar" />
    </HBox>

    <TableView fx:id="tabla" style="-fx-background-radius: 10; -fx-border-color: #E3F2FD; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" prefWidth="220" text="Nombre" />
            <TableColumn fx:id="colEmail" prefWidth="280" text="Correo" />
            <TableColumn fx:id="colRol" prefWidth="160" text="Rol" />
            <TableColumn fx:id="colEstado" prefWidth="120" text="Estado" />
            <TableColumn fx:id="colRegistro" prefWidth="180" text="Alta" />
        </columns>
    </TableView>

    <Label fx:id="lblDetalle" style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Selecciona una cuenta para ver su situación" />
    
</VBox>
