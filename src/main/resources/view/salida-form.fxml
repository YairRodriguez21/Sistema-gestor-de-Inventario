<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" focusTraversable="false" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sapam.inventario.javafx.controller.SalidaFormController">
    <content>
        <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 15;">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Salida de almacén" />

            <Label style="-fx-font-weight: bold;" text="Productos que salen" />
            <TextField fx:id="txtEscanear" onAction="#agregarPorEscaneo" promptText="Escanea el código de barras: cada lectura agrega 1 unidad" style="-fx-pref-height: 40px; -fx-background-radius: 8; -fx-border-color: #E3F2FD; -fx-border-radius: 8;" />
            <HBox alignment="CENTER_LEFT" spacing="8">
                <ComboBox fx:id="cmbProducto" promptText="Seleccionar producto" HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtCantidad" prefWidth="90" promptText="Cant." />
                <Button onAction="#agregarProducto" style="-fx-background-color: #E3F2FD; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-pref-width: 90px;" text="Añadir" />
            </HBox>

            <TableView fx:id="tablaProductos" prefHeight="170">
                <columns>
                    <TableColumn fx:id="colProducto" prefWidth="230" text="Producto" />
                    <TableColumn fx:id="colCantidad" prefWidth="80" text="Cantidad" />
                    <TableColumn fx:id="colAcciones" prefWidth="170" text="Corregir" />
                </columns>
            </TableView>

            <Label fx:id="lblResumen" style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="0 productos, 0 unidades" />

            <Label style="-fx-font-weight: bold;" text="Número de orden de trabajo *" />
            <TextField fx:id="txtOrdenTrabajo" promptText="La que autoriza la salida (obligatorio)" />

            <Label style="-fx-font-weight: bold;" text="Motivo de la salida *" />
            <ComboBox fx:id="cbMotivo" maxWidth="Infinity" onAction="#motivoCambiado" promptText="Seleccione un motivo" />

            <Label fx:id="lblMotivoOtro" managed="false" style="-fx-font-weight: bold;" text="¿En qué consiste? *" visible="false" />
            <TextField fx:id="txtMotivoOtro" managed="false" promptText="Describa el motivo" visible="false" />

            <Label style="-fx-font-weight: bold;" text="Quién solicita *" />
            <ComboBox fx:id="cbSolicita" editable="true" maxWidth="Infinity" promptText="Nombre a mano o ya usado antes" />

            <Label text="Puesto / cargo" />
            <TextField fx:id="txtPuesto" promptText="Opcional" />

            <Label text="Departamento / área *" />
            <TextField fx:id="txtDepartamento" promptText="Área o departamento (obligatorio)" />

            <Label style="-fx-font-weight: bold;" text="Quién recibe *" />
            <ComboBox fx:id="cbRecibe" editable="true" maxWidth="Infinity" promptText="Persona que retira el material (nombre y apellido)" />

            <Label style="-fx-font-weight: bold;" text="Responsable" />
            <Label fx:id="lblResponsable" style="-fx-text-fill: #080808;" wrapText="true"
                   text="Sale de la cuenta con la que entraste: no se cambia" />

            <Label text="Observaciones" />
            <TextArea fx:id="txtObservaciones" prefRowCount="3" promptText="Opcional" wrapText="true" />

            <HBox alignment="CENTER" spacing="10">
                <Button onAction="#guardarSalida" style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 150px;" text="Registrar salida" />
                <Button onAction="#cancelar" style="-fx-background-color: #E3F2FD; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-pref-width: 100px;" text="Cancelar" />
            </HBox>
        </VBox>
    </content>
</ScrollPane>
