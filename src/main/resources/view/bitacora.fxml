<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="10" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sapam.inventario.javafx.controller.BitacoraController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Bitácora del sistema" />
    <Label fx:id="lblResumen" style="-fx-text-fill: #6c757d;" text="Registro de cada acción realizada en el sistema" />

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-weight: bold;" text="Acción:" />
        <ComboBox fx:id="cbAccion" onAction="#aplicarFiltro" prefWidth="260" promptText="Todas" />
        <Label style="-fx-font-weight: bold;" text="Usuario:" />
        <ComboBox fx:id="cbUsuario" onAction="#aplicarFiltro" prefWidth="240" promptText="Todos" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#actualizar" style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Actualizar" />
        <Button onAction="#cerrar" style="-fx-background-color: #E3F2FD; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 8;" text="Cerrar" />
    </HBox>

    <TableView fx:id="tablaEventos" style="-fx-background-radius: 10; -fx-border-color: #E3F2FD; -fx-border-radius: 10;" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFecha" prefWidth="95" text="Fecha" />
            <TableColumn fx:id="colHora" prefWidth="75" text="Hora" />
            <TableColumn fx:id="colUsuario" prefWidth="175" text="Usuario" />
            <TableColumn fx:id="colAccion" prefWidth="185" text="Acción" />
            <TableColumn fx:id="colModulo" prefWidth="120" text="Módulo" />
            <TableColumn fx:id="colDetalle" prefWidth="340" text="Qué cambió" />
            <TableColumn fx:id="colObservaciones" prefWidth="280" text="Observaciones" />
            <TableColumn fx:id="colCodigo" prefWidth="300" text="Código de verificación" />
        </columns>
    </TableView>

    <HBox alignment="CENTER" spacing="12">
        <Button fx:id="btnAnterior" onAction="#paginaAnterior" style="-fx-background-color: #E3F2FD; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 8;" text="Anterior" />
        <Label fx:id="lblPagina" style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Página 1 de 1" />
        <Button fx:id="btnSiguiente" onAction="#paginaSiguiente" style="-fx-background-color: #4A90E2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Siguiente" />
    </HBox>

    <Label style="-fx-text-fill: #dc3545;" text="Esta bitácora no tiene borrado ni edición: solo se consulta." />
</VBox>
