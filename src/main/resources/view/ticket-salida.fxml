<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  Ticket para la impresora térmica POS-80, que es la que entrega las salidas.

  La prueba de impresión confirmó que el área imprimible del driver es de unos
  272 px (71.9 mm) y que este ticket de 192 px (50.8 mm) entra completo, con
  margen de sobra. No se ensancha sin volver a medir: el texto que llega al
  borde imprimible se recorta. FxmlTest vigila que se mantenga en este ancho.
-->
<VBox alignment="TOP_CENTER" fillWidth="false" spacing="6" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sapam.inventario.javafx.controller.TicketSalidaController" prefWidth="216">
    <padding>
        <Insets bottom="14" left="12" right="12" top="14" />
    </padding>

    <VBox fx:id="vbTicket" spacing="3" prefWidth="192">
        <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="TICKET DE SALIDA" />
        <Label fx:id="lblFolio" maxWidth="Infinity" style="-fx-font-size: 11px; -fx-font-weight: bold;" textAlignment="CENTER" wrapText="true" />
        <Region prefHeight="1" maxWidth="Infinity" style="-fx-background-color: black;" />

        <HBox spacing="6">
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Fecha:" prefWidth="76" />
            <Label fx:id="lblFechaHora" style="-fx-font-size: 11px;" HBox.hgrow="ALWAYS" wrapText="true" />
        </HBox>

        <HBox spacing="6">
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Entregó:" prefWidth="76" />
            <Label fx:id="lblEntrego" style="-fx-font-size: 11px;" HBox.hgrow="ALWAYS" wrapText="true" />
        </HBox>

        <HBox spacing="6">
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Orden:" prefWidth="76" />
            <Label fx:id="lblOrdenTrabajo" style="-fx-font-size: 11px;" HBox.hgrow="ALWAYS" wrapText="true" />
        </HBox>

        <HBox spacing="6">
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Solicitó:" prefWidth="76" />
            <Label fx:id="lblSolicita" style="-fx-font-size: 11px;" HBox.hgrow="ALWAYS" wrapText="true" />
        </HBox>

        <HBox spacing="6">
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Área:" prefWidth="76" />
            <Label fx:id="lblArea" style="-fx-font-size: 11px;" HBox.hgrow="ALWAYS" wrapText="true" />
        </HBox>

        <HBox spacing="6">
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Recibe:" prefWidth="76" />
            <Label fx:id="lblRecibe" style="-fx-font-size: 11px;" HBox.hgrow="ALWAYS" wrapText="true" />
        </HBox>

        <HBox spacing="6">
            <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Motivo:" prefWidth="76" />
            <Label fx:id="lblMotivo" style="-fx-font-size: 11px;" HBox.hgrow="ALWAYS" wrapText="true" />
        </HBox>

        <Region prefHeight="1" maxWidth="Infinity" style="-fx-background-color: black;" />

        <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Productos entregados" />
        <!--
          Sin tabla: la tabla de JavaFX dibuja sus bordes y su encabezado a un
          ancho de pantalla y sale todo desalineado. Cada producto es un
          renglón de dos etiquetas, que es lo que la térmica imprime limpio.
        -->
        <VBox fx:id="vbProductos" spacing="1" />

        <Region prefHeight="1" maxWidth="Infinity" style="-fx-background-color: black;" />

        <Label style="-fx-font-size: 11px; -fx-font-weight: bold;" text="Observaciones" />
        <Label fx:id="lblObservaciones" style="-fx-font-size: 11px;" wrapText="true" />
    </VBox>

    <HBox alignment="CENTER" spacing="10">
        <!--
          Entre los dos caben en 190 px: si se pasaran, la ventana crecería más
          que el papel y el ticket dejaría de parecerse a lo que sale impreso.
        -->
        <Button onAction="#imprimirTicket" style="-fx-background-color: #28A745; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-width: 98px;" text="Imprimir" />
        <Button onAction="#cerrarTicket" style="-fx-background-color: #E3F2FD; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-pref-width: 82px;" text="Cerrar" />
    </HBox>
</VBox>
